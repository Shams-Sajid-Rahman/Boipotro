NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/boipotro

# Use long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Separate throwaway database used by `npm test` (it is wiped on every run).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/boipotro_test
